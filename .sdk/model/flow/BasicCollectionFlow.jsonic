# BasicCollectionFlow

main: kit: flow: BasicCollectionFlow:
{
  entity: "collection",
  kind: "basic",
  name: "BasicCollectionFlow",
  step: [
    {
      input: {
        ref: "collection_ref01"
      }

      match: {
        collection_id: "collection01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "collection_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "collection_ref01",
        srcdatavar: "collection_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-collection_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "collection_ref01",
        srcdatavar: "collection_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "collection01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-collection_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "collection_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "collection01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "collection_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCollectionFlow"
}