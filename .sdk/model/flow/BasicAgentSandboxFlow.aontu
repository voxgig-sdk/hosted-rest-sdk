# BasicAgentSandboxFlow

main: kit: flow: BasicAgentSandboxFlow:
{
  entity: "agent_sandbox",
  kind: "basic",
  name: "BasicAgentSandboxFlow",
  step: [
    {
      i: {
        ref: "agent_sandbox_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "agent_sandbox_ref01",
        srcdatavar: "agent_sandbox_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_sandbox_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentSandboxFlow"
}