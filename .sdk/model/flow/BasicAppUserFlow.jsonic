# BasicAppUserFlow

main: kit: flow: BasicAppUserFlow:
{
  entity: "app_user",
  kind: "basic",
  name: "BasicAppUserFlow",
  step: [
    {
      input: {
        ref: "app_user_ref01"
      }

      match: {
        collection_id: "collection01",
        project_id: "project01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "app_user_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "app_user_ref01",
        srcdatavar: "app_user_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-app_user_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "app_user_ref01",
        srcdatavar: "app_user_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "app_user01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-app_user_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "app_user_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "app_user01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "app_user_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAppUserFlow"
}