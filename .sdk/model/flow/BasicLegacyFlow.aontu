# BasicLegacyFlow

main: kit: flow: BasicLegacyFlow:
{
  entity: "legacy",
  kind: "basic",
  name: "BasicLegacyFlow",
  step: [
    {
      i: {
        ref: "legacy_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "legacy_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "legacy_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "legacy01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "legacy_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLegacyFlow"
}