# Entity: agent_health

main: kit: entity: agent_health: {

  alias: field: {}

  fields: [
    {
      name: "deprecations"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "rate_limit_status"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "status"
      req: true
      type: "`$STRING`"
    }
    {
      name: "uptime_seconds"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "version"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "agent_health"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/agent/v1/health"
          parts: [
            "agent"
            "v1"
            "health"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
