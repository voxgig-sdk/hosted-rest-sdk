# Entity: app_user_login

main: kit: entity: app_user_login: {

  alias: field: {}

  fields: [
    {
      name: "email"
      req: true
      type: "`$STRING`"
    }
    {
      name: "metadata"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "project_id"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "app_user_login"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/app-users/login"
          parts: [
            "api"
            "app-users"
            "login"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
