# Entity: authentication

main: kit: entity: authentication: {

  alias: field: {}

  name: "authentication"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/logout"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "logout"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
