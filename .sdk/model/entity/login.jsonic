# Entity: login

main: kit: entity: login: {

  alias: field: {}

  fields: [
    {
      name: "email"
      req: true
      type: "`$STRING`"
    }
    {
      name: "password"
      req: true
      type: "`$STRING`"
    }
    {
      name: "token"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "login"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/login"
          parts: [
            "api"
            "login"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
