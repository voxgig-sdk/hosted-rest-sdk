re\":{\"type\":\"boolean\"},\"limit\":{\"type\":\"integer\"},\"next_cursor\":{\"description\":\"Opaque cursor or null if at end.\",\"type\":[\"string\",\"null\"]},\"prev_cursor\":{\"description\":\"Always null in v1 (forward-only pagination).\",\"type\":[\"string\",\"null\"]},\"returned\":{\"type\":\"integer\"},\"total_estimate\":{\"type\":\"integer\"}},\"required\":[\"limit\",\"returned\",\"next_cursor\",\"prev_cursor\",\"has_more\",\"total_estimate\"],\"type\":\"object\"}},\"required\":[\"data\",\"meta\"],\"type\":\"object\"}}},\"description\":\"Paginated user list\"}},\"securitySchemes\":{\"ApiKeyAuth\":{\"in\":\"header\",\"name\":\"x-api-key\",\"type\":\"apiKey\"},\"BearerAuth\":{\"bearerFormat\":\"session_token\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"unspecified\"}"
