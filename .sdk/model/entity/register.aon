# Entity: register

main: kit: entity: register: {

  alias: field: {}

  fields: [
    {
      format: "email"
      name: "email"
      req: true
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "password"
      req: true
      type: "`$STRING`"
    }
    {
      name: "token"
      req: true
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "register"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/register"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "register"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
