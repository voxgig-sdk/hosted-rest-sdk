# Entity: agent_sandbox

main: kit: entity: agent_sandbox: {

  alias: field: {}

  fields: [
    {
      format: "email"
      name: "email"
      req: true
      type: "`$STRING`"
    }
    {
      name: "password"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "agent_sandbox"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/agent/v1/auth/login"
          segments: [
            {
              lit: "agent"
            }
            {
              lit: "v1"
            }
            {
              lit: "auth"
            }
            {
              lit: "login"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "cursor"
                orig: "cursor"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 20
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 42
                kind: "query"
                name: "seed"
                orig: "seed"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "status"
                orig: "status"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/agent/v1/orders"
          segments: [
            {
              lit: "agent"
            }
            {
              lit: "v1"
            }
            {
              lit: "orders"
            }
          ]
          select: {
            exist: [
              "cursor"
              "limit"
              "seed"
              "status"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "scenario"
                orig: "scenario"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/agent/v1/scenarios/{scenario}"
          segments: [
            {
              lit: "agent"
            }
            {
              lit: "v1"
            }
            {
              lit: "scenarios"
            }
            {
              var: "scenario"
            }
          ]
          select: {
            exist: [
              "scenario"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/agent/v1/scenarios"
          segments: [
            {
              lit: "agent"
            }
            {
              lit: "v1"
            }
            {
              lit: "scenarios"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
